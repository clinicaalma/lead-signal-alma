# Meta: ID do Pixel/dataset (Gerenciador de Eventos > Fontes de dados)
META_PIXEL_ID=
# Meta: token da Conversions API (Gerenciador de Eventos > Configurações > Conversions API > Gerar token)
META_CAPI_TOKEN=
# Opcional: código de teste (Gerenciador de Eventos > Testar eventos). Apague depois de validar.
META_TEST_EVENT_CODE=
# Opcional: versão da Graph API (padrão v23.0)
META_GRAPH_VERSION=
# WhatsApp da clínica, só números com 55 + DDD (ex.: 5545999999999)
WHATSAPP_NUMERO=
# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Senha do CRM em /painel
PAINEL_SENHA=

# Meta: ID do Pixel/dataset (Gerenciador de Eventos > Fontes de dados)
META_PIXEL_ID=
# Meta: token da Conversions API (Gerenciador de Eventos > Configurações > Conversions API > Gerar token)
META_CAPI_TOKEN=
# Opcional: código de teste (Gerenciador de Eventos > Testar eventos). Apague depois de validar.
META_TEST_EVENT_CODE=
# Opcional: versão da Graph API (padrão v23.0)
META_GRAPH_VERSION=
# WhatsApp da clínica, só números com 55 + DDD (ex.: 5545999999999)
WHATSAPP_NUMERO=
# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Senha do CRM em /painel
PAINEL_SENHA=

# ===== Black Alma (/black e /painel/black) =====
# Link de convite do grupo VIP (https://chat.whatsapp.com/...)
BLACK_GRUPO_LINK=
# Data e hora da divulgação das ofertas, formato ISO com fuso (padrão: 2026-11-09T19:00:00-03:00)
BLACK_ABERTURA=2026-11-09T19:00:00-03:00
# Opcionais: contagem automática de membros do grupo a cada 30 min (Evolution API).
# Sem as quatro, o painel mostra um campo para digitar o total de membros.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# ID do grupo, termina em @g.us (ex.: 120363000000000000@g.us)
BLACK_GRUPO_JID=
